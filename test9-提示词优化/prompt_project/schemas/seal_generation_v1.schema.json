{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": true,
  "properties": {
    "questions": {
      "type": "object",
      "required": ["q1", "q2", "q3"],
      "additionalProperties": false,
      "properties": {
        "q1": { "$ref": "#/$defs/question" },
        "q2": { "$ref": "#/$defs/question" },
        "q3": { "$ref": "#/$defs/question" }
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["question", "options", "answer"],
      "additionalProperties": true,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "enum": ["A", "B", "C", "D"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "answer": { "enum": ["A", "B", "C", "D"] }
      }
    }
  }
}
