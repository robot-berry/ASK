{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test6_compact_five_natural_tiers_physics_v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["l1", "l2", "l3", "l4", "l5", "f", "pat", "s", "u"],
  "properties": {
    "l1": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/l1Part"}},
    "l2": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "l3": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/l3Part"}},
    "l4": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/l4Part"}},
    "l5": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/l5Part"}},
    "f": {"type": "array", "minItems": 0, "maxItems": 3, "items": {"$ref": "#/$defs/formula"}},
    "pat": {"type": "string", "minLength": 4, "maxLength": 100},
    "s": {"type": "string", "enum": ["c", "u"]},
    "u": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
  },
  "$defs": {
    "l1Part": {
      "type": "object", "additionalProperties": false, "required": ["n", "s"],
      "properties": {"n": {"type": "string", "minLength": 1, "maxLength": 20}, "s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 8, "maxLength": 80}}}
    },
    "l3Part": {
      "type": "object", "additionalProperties": false, "required": ["n", "s"],
      "properties": {"n": {"type": "string", "minLength": 1, "maxLength": 20}, "s": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 8, "maxLength": 80}}}
    },
    "l4Part": {
      "type": "object", "additionalProperties": false, "required": ["n", "s"],
      "properties": {"n": {"type": "string", "minLength": 1, "maxLength": 20}, "s": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 8, "maxLength": 80}}}
    },
    "l5Part": {
      "type": "object", "additionalProperties": false, "required": ["n", "s", "pit"],
      "properties": {"n": {"type": "string", "minLength": 1, "maxLength": 20}, "s": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 8, "maxLength": 80}}, "pit": {"type": "string", "minLength": 2, "maxLength": 100}}
    },
    "formula": {
      "type": "object", "additionalProperties": false, "required": ["x", "c"],
      "properties": {"x": {"type": "string", "minLength": 1, "maxLength": 120}, "c": {"type": "string", "minLength": 1, "maxLength": 100}}
    }
  }
}
