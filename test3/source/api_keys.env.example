# Copy this file to api_keys.env and fill in a newly rotated key.
# Never commit api_keys.env or paste the key into logs.
DASHSCOPE_API_KEY=replace_with_your_rotated_key

# Optional overrides:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_WORKSPACE_ID=replace_with_your_workspace_id
