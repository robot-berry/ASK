{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.test7-ocr/schemas/question_document.schema.json",
  "title": "Question document",
  "type": "object",
  "required": [
    "schema_version",
    "sample_id",
    "source_image",
    "source_sha256",
    "provider",
    "canonical_text",
    "display_text",
    "stem",
    "options",
    "source_blocks",
    "visual_assets",
    "handwriting_detected",
    "formula_verified",
    "formula_specialist_used",
    "formula_count",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "question_document_v2"},
    "sample_id": {"type": "string", "minLength": 1},
    "source_image": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "canonical_text": {"type": "string"},
    "display_text": {"type": "string"},
    "question_number": {"type": ["string", "null"]},
    "stem": {"type": "string"},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {"type": "string"},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "source_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id", "kind", "text", "source_bbox", "confidence", "disposition", "reason"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["text", "formula", "unknown"]},
          "text": {"type": "string", "minLength": 1},
          "source_bbox": {
            "type": ["object", "null"],
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "disposition": {"enum": ["emitted", "ignored", "review_required"]},
          "reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "visual_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "source_bbox",
          "crop_path",
          "crop_sha256",
          "extraction",
          "bbox_source",
          "bbox_verified",
          "preserve_source_pixels",
          "redraw_used",
          "fallback",
          "edge_complete"
        ],
        "properties": {
          "asset_id": {"type": "string"},
          "source_bbox": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            }
          },
          "crop_path": {"type": "string"},
          "crop_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"type": "string"},
          "extraction": {"const": "direct_source_crop"},
          "bbox_source": {"type": "string", "minLength": 1},
          "bbox_verified": {"type": "boolean"},
          "preserve_source_pixels": {"const": true},
          "redraw_used": {"const": false},
          "fallback": {"type": "boolean"},
          "edge_complete": {"type": "boolean"}
        }
      }
    },
    "handwriting_detected": {"type": "boolean"},
    "formula_verified": {"type": "boolean"},
    "formula_specialist_used": {"type": "boolean"},
    "formula_count": {"type": "integer", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "source_resolution": {
      "type": ["object", "null"],
      "required": [
        "input_image",
        "input_sha256",
        "effective_image",
        "effective_sha256",
        "substituted",
        "method",
        "evidence"
      ],
      "properties": {
        "input_image": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "effective_image": {"type": "string", "minLength": 1},
        "effective_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "substituted": {"type": "boolean"},
        "method": {"enum": ["direct_input", "verified_capture_pair_clean_source_direct_pixels"]},
        "evidence": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": [
                "pair_task_path",
                "pair_task_sha256",
                "pair_status",
                "pair_partition",
                "capture_asset_id",
                "capture_role",
                "capture_registered_image",
                "capture_sha256",
                "clean_asset_id",
                "clean_registered_image",
                "clean_sha256",
                "document_group",
                "page_index",
                "annotator_id",
                "reviewer_id"
              ],
              "properties": {
                "pair_task_path": {"type": "string", "minLength": 1},
                "pair_task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "pair_status": {"const": "verified"},
                "pair_partition": {"const": "quarantine"},
                "capture_asset_id": {"type": "string", "pattern": "^SBI-HAND-"},
                "capture_role": {"const": "handwriting_capture"},
                "capture_registered_image": {"type": "string", "minLength": 1},
                "capture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "clean_asset_id": {"type": "string", "pattern": "^SBI-CLEAN-"},
                "clean_registered_image": {"type": "string", "minLength": 1},
                "clean_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "document_group": {"type": "string", "minLength": 1},
                "page_index": {"type": "integer", "minimum": 1},
                "annotator_id": {"type": "string", "minLength": 2},
                "reviewer_id": {"type": "string", "minLength": 2}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"substituted": {"const": true}}},
          "then": {
            "properties": {
              "method": {"const": "verified_capture_pair_clean_source_direct_pixels"},
              "evidence": {"type": "object"}
            }
          },
          "else": {
            "properties": {
              "method": {"const": "direct_input"},
              "evidence": {"type": "null"}
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
