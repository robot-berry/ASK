{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/test7-ocr/ocr_gold.schema.json",
  "title": "test7-OCR OCR gold record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gold_id",
    "sample_id",
    "partition",
    "subject",
    "scope",
    "locale",
    "source",
    "content",
    "layout",
    "visual_assets",
    "handwriting",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "ocr_gold_v1" },
    "gold_id": { "type": "string", "minLength": 1 },
    "sample_id": { "type": "string", "minLength": 1 },
    "partition": { "enum": ["dev_eval", "regression", "frozen_test", "test"] },
    "subject": { "enum": ["mathematics", "physics"] },
    "scope": { "enum": ["middle_school", "high_school", "unknown"] },
    "locale": { "type": "string", "minLength": 2 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "dataset_version", "image_path", "image_sha256", "width", "height", "color_mode", "document_group", "evaluation_only", "training_allowed"],
      "properties": {
        "dataset": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "image_path": { "type": "string", "minLength": 1 },
        "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "color_mode": { "type": "string", "minLength": 1 },
        "document_group": { "type": "string", "minLength": 1 },
        "evaluation_only": { "const": true },
        "training_allowed": { "const": false }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_type", "question_type_label", "stem_text", "options", "constants", "semantic_text", "formula_gold_status"],
      "properties": {
        "question_type": { "type": "string", "minLength": 1 },
        "question_type_label": { "type": "string" },
        "stem_text": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "constants": { "type": "array", "items": { "type": "string" } },
        "semantic_text": { "type": "string", "minLength": 1 },
        "formula_gold_status": { "enum": ["embedded_unicode_only", "generator_source_verified", "human_transcribed", "latex_verified"] }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_text_region", "source_metadata_regions", "source_ignore_regions", "reading_order", "body_font_size"],
      "properties": {
        "source_text_region": { "$ref": "#/$defs/bbox" },
        "source_metadata_regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "source_ignore_regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "reading_order": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "body_font_size": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "visual_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "kind", "diagram_type", "source_bbox", "placement_hint", "preserve_source_pixels", "redraw_allowed", "required_facts"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["table", "geometry_figure", "force_diagram", "circuit_diagram", "physics_diagram", "other_figure"] },
          "diagram_type": { "type": "string", "minLength": 1 },
          "source_bbox": { "$ref": "#/$defs/bbox" },
          "placement_hint": { "enum": ["right_of_text", "after_text"] },
          "preserve_source_pixels": { "const": true },
          "redraw_allowed": { "const": false },
          "required_facts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "handwriting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "gold_status"],
      "properties": {
        "expected": { "type": "boolean" },
        "gold_status": { "enum": ["synthetic_clean_source", "human_verified_absent", "human_regions_annotated"] }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "independent_review_count", "required_independent_review_count", "source_alignment"],
      "properties": {
        "status": { "enum": ["machine_derived_pending_double_review", "adjudication_required", "verified", "source_generated_verified"] },
        "independent_review_count": { "type": "integer", "minimum": 0 },
        "required_independent_review_count": { "enum": [0, 2] },
        "source_alignment": { "enum": ["generator_fact_source", "human_verified"] }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "exclusiveMinimum": 0 },
        { "type": "integer", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "kind", "bbox", "reason"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["header", "question_type_tag", "footer", "boilerplate", "privacy_redaction", "student_handwriting", "teacher_mark", "watermark", "non_question_noise", "overlap_unrecoverable", "uncertain"] },
        "bbox": { "$ref": "#/$defs/bbox" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
