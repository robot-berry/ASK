    "knowledge_points": [
      "勾股定理：在直角三角形中，已知两条直角边可以求斜边。",
      "直角三角形的边角对应：∠C=90°时，AB是斜边，AC和BC是直角边。",
      "三角形周长：周长等于三条边长之和。"
    ],
    "base_formulas": [
      {
        "formula": "a²+b²=c²",
        "condition": "直角三角形中，两直角边分别为a、b，斜边为c"
      },
      {
        "formula": "C=a+b+c",
        "condition": "三角形三边分别为a、b、c"
      }
    ],
    "parts": [
      {
        "part": "1",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求斜边AB的长，已知AC=9、BC=12，且∠C=90°。",
              "因为∠C是直角，所以AB是斜边，AC和BC是两条直角边。",
              "勾股定理给出AC²+BC²=AB²，代入得9²+12²=AB²。",
              "计算9²+12²=81+144=225，所以AB²=225。"
            ],
            "pitfall": "使用勾股定理时，要确认AB是斜边，不能把直角边和斜边位置放错。"
          }
        ]
      },
      {
        "part": "2",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求三角形ABC的周长，已知AC=9、BC=12，还需要斜边AB。",
              "由∠C=90°知AB是斜边，勾股定理给出AB²=AC²+BC²。",
              "代入AC=9、BC=12，得AB²=9²+12²=225。",
              "AB为正数，所以AB=√225，周长可写成9+12+AB。"
            ],
            "pitfall": "周长要把三条边都加上，不能只加两条直角边。"
          }
        ]
      }
    ],
