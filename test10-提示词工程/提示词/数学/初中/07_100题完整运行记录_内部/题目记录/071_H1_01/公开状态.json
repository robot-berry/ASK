    "model_id": "deepseek-ai/DeepSeek-V4.1-Flash",
    "knowledge_points": [
      "待定系数法：利用抛物线与x轴的两个交点坐标，代入解析式求出b和c。",
      "二次函数与y轴交点：令x=0，由解析式求出点C的纵坐标。",
      "三角形面积公式：以AB为底，点C到x轴的距离为高，计算面积。",
      "二次函数在区间上的最值：点P的纵坐标决定三角形PAB的高，需结合P在A、B之间的范围分析。"
    ],
    "base_formulas": [
      {
        "formula": "y=ax²+bx+c",
        "condition": "二次函数图象与x轴交于两点时，交点坐标满足函数解析式"
      },
      {
        "formula": "S=1/2×底×高",
        "condition": "三角形面积公式，底为AB，高为点C到x轴的距离"
      },
      {
        "formula": "y=ax²+bx+c",
        "condition": "点P在抛物线上，其纵坐标的绝对值表示到x轴的距离"
      }
    ],
    "parts": [
      {
        "part": "（1）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知抛物线y=x²+bx+c与x轴交于A(-2,0)和B(4,0)，要求解析式，就是求b和c。",
              "因为A、B在抛物线上，它们的坐标应满足解析式，分别代入得到两个方程。",
              "由A得0=4-2b+c，由B得0=16+4b+c，这两个方程联立可解出b和c。",
              "解出b、c后，抛物线解析式就确定了，可用来求点C和点P的坐标。"
            ],
            "pitfall": "代入交点坐标时注意符号，尤其是A(-2,0)代入后x²=4，不要写成-4。"
          }
        ]
      },
      {
        "part": "（2）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "三角形ABC的底边AB在x轴上，由A(-2,0)和B(4,0)可知AB=6。",
              "顶点C是抛物线与y轴的交点，令x=0得y=c，所以C的坐标为(0,c)。",
              "点C到x轴的距离为|c|，这就是三角形ABC的高。"
            ],
            "pitfall": "点C的纵坐标是c，高应取|c|，不要漏掉绝对值。"
          }
        ]
      },
      {
        "part": "（3）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "点P在A、B之间的抛物线上，横坐标x满足-2<x<4，纵坐标y=x²+bx+c。",
              "三角形PAB的底AB=6，高是点P到x轴的距离，即|y|。",
              "在-2<x<4内，需判断y的正负；若y≥0，则高为y，面积S=1/2×6×y=3y。",
              "将y=x²+bx+c代入S=3y，得到面积关于x的二次函数，再在-2<x<4内求最大值。"
            ],
            "pitfall": "点P在A、B之间时，纵坐标可能为负，高应取|y|，不能直接写y。"
          }
        ]
      }
    ],
