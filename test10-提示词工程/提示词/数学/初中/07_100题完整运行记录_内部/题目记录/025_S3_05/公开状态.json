        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目已知直角三角形ABC中∠C=90°，AC=15，BC=20，要求斜边AB的长和三角形ABC的周长。",
              "因为∠C=90°，所以AC和BC是两条直角边，AB是斜边，适用勾股定理AB²=AC²+BC²。",
              "把AC=15、BC=20代入，得到AB²=15²+20²，先算出AB²的值，再求AB。",
              "求出AB后，三角形周长等于AC+BC+AB，即15+20+AB，把三边长度相加。"
            ],
            "pitfall": "使用勾股定理时，要确认AC和BC是直角边，AB是斜边，不能把斜边和直角边混淆。"
          }
        ]
      }
