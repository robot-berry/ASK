  "analysis_audit": {
    "source": "complete_model",
    "model_id": "deepseek-ai/DeepSeek-V4.1-Flash",
    "knowledge_points": [
      "切线性质：切线垂直于过切点的半径，为构造直角三角形提供直角。",
      "切线长定理：从圆外一点引圆的两条切线，切线长相等，因此PA=PB。",
      "垂径定理：过圆心作弦的垂线平分弦，用于求弦心距。",
      "勾股定理：在直角三角形中建立边长之间的平方关系。"
    ],
    "base_formulas": [
      {
        "formula": "OA⊥PA，OB⊥PB",
        "condition": "圆的切线垂直于过切点的半径"
      },
      {
        "formula": "PA=PB",
        "condition": "从圆外一点引圆的两条切线，切线长相等"
      },
      {
        "formula": "在直角三角形中，两直角边的平方和等于斜边的平方",
        "condition": "垂径定理及勾股定理"
      }
    ],
    "parts": [
      {
        "part": "1",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求PA的长度，已知圆半径OA=50，弦AB=80，且PA、PB是过A、B的切线。",
              "由切线性质得OA⊥PA，所以△OAP是直角三角形，斜边为OP。",
              "设OP与AB交于H，由垂径定理得AH=40，且OH⊥AB，于是△OAH中OA=50，AH=40。",
              "在△OAH中，由勾股定理得OH²=OA²-AH²=50²-40²，所以OH=30；又由切线长定理PA=PB，且OA=OB，可得OP垂直平分AB，H为AB中点。"
            ],
            "pitfall": "注意OH是OP的一部分，不能把OP直接写成半径与弦心距的和或差；相似三角形对应边要核对准确。"
          }
        ]
      }
    ],
