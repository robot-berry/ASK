    "knowledge_points": [
      "切线性质：切线垂直于过切点的半径，用于得到直角。",
      "切线长定理：从圆外一点引圆的两条切线，切线长相等，用于确定PA与PB的关系。",
      "垂径定理：过圆心作弦的垂线平分弦，用于求弦心距。",
      "勾股定理：在直角三角形中建立边长之间的平方关系。"
    ],
    "base_formulas": [
      {
        "formula": "OA⊥PA，OB⊥PB",
        "condition": "圆的切线垂直于过切点的半径"
      },
      {
        "formula": "PA=PB",
        "condition": "从圆外一点引圆的两条切线，切线长相等"
      },
      {
        "formula": "a²+b²=c²",
        "condition": "在直角三角形中，两直角边的平方和等于斜边的平方"
      }
    ],
    "parts": [
      {
        "part": "1",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知圆O半径OA=20，弦AB=32，过A、B的切线交于P，要求PA。",
              "作OH⊥AB于H，由垂径定理得AH=16，在Rt△OHA中，OH²=20²-16²，所以OH=12。",
              "因为PA、PB是切线，所以PA=PB，且OA⊥PA，OB⊥PB，OP垂直平分AB，H在OP上。",
              "在Rt△OAP中，OA=20，OP=OH+HP=12+HP，PA²=OP²-20²；又由△OHA~△OAP得OH/OA=AH/AP=16/1"
            ],
            "pitfall": "注意OH是弦心距，不是OP；OP=OH+HP，不能把OH直接当作OP。"
          }
        ]
      }
    ],
