    "knowledge_points": [
      "二次函数与x轴交点：交点横坐标满足函数值为零，可用来确定解析式中的系数。",
      "三角形面积：底边AB在x轴上，高是点C到x轴的竖直距离。",
      "二次函数在区间上的最值：开口方向与顶点位置共同决定面积的最大值。",
      "动点坐标与面积关系：点P的纵坐标绝对值表示到x轴的距离，需结合运动范围判断符号。"
    ],
    "base_formulas": [
      {
        "formula": "x₁+x₂=-b, x₁ₓ₂=c",
        "condition": "抛物线与x轴交于两点时，交点横坐标是方程 x²+bx+c=0 的根"
      },
      {
        "formula": "S=1/2×底×高",
        "condition": "三角形面积公式，底为水平线段时高为竖直距离"
      },
      {
        "formula": "y=a(x-h)²+k",
        "condition": "二次函数在给定区间上的最值需结合开口方向和顶点位置判断"
      }
    ],
    "parts": [
      {
        "part": "（1）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求抛物线 y=x²+bx+c 的解析式，已知它与x轴交于A(-4,0)和B(6,0)。",
              "因为A、B在x轴上，所以-4和6是方程 x²+bx+c=0 的两个根。",
              "由根与系数的关系，两根之和为 -b，两根之积为 c。",
              "把-4和6代入，得到 -4+6=-b 以及 (-4)×6=c，由此可解出b和c。"
            ],
            "pitfall": "不要忽略两根之和与两根之积的符号，尤其两根之积等于c而不是-c。"
          }
        ]
      },
      {
        "part": "（2）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求三角形ABC的面积，A、B在x轴上，C是抛物线与y轴的交点。",
              "底边AB的长度等于A、B横坐标之差的绝对值",
              "点C的横坐标为0，纵坐标等于解析式中的常数项c，所以高是 |c|。",
              "三角形面积公式为 S=1/2×底×高，代入底10和高 |c| 即可。"
            ],
            "pitfall": "点C的纵坐标可能为负，三角形的高应取绝对值，不能直接把负的纵坐标当作高。"
          }
        ]
      },
      {
        "part": "（3）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求三角形PAB面积的最大值及此时P的坐标，P在A、B之间的抛物线上。",
              "底边AB长度固定为10，面积取决于点P到x轴的距离，即高的长度。",
              "在A、B之间，抛物线位于x轴下方，点P的纵坐标y为负，所以高为-y。",
              "面积可表示为 S=1/2×10×(-y)，把抛物线解析式代入后得到关于x的二次函数。"
            ],
            "pitfall": "在A、B之间抛物线在x轴下方，高应写成-y而不是y，否则面积符号会出错。"
          }
        ]
      }
    ],
