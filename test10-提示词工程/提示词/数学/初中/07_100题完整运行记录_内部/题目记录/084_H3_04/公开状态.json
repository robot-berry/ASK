    "knowledge_points": [
      "垂径定理：垂直于弦的直径平分弦，因此H是AB的中点，AH=AB/2。",
      "勾股定理：在直角三角形OHA中，OH、AH、OA满足勾股关系，可求OH。",
      "切线长定理：从圆外一点引圆的两条切线，切线长相等，所以PA=PB。",
      "切线性质：切线垂直于过切点的半径，因此OA⊥PA，△OAP是直角三角形。",
      "全等三角形：△OAP与△OBP全等，四边形OAPB的面积等于这两个三角形面积之和。"
    ],
    "base_formulas": [
      {
        "formula": "OH² + (AB/2)² = OA²",
        "condition": "在圆中，弦心距、半弦和半径构成直角三角形"
      },
      {
        "formula": "PA = PB",
        "condition": "从圆外一点引圆的两条切线，切线长相等"
      },
      {
        "formula": "OA ⊥ PA",
        "condition": "切线垂直于过切点的半径"
      }
    ],
    "parts": [
      {
        "part": "（1）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知圆O半径OA=20，弦AB=32，OH⊥AB于H，目标是求OH的长。",
              "因为OH过圆心且垂直于弦AB，由垂径定理，H是AB的中点，所以AH=AB/2=16。",
              "在Rt△OHA中，斜边OA=20，直角边AH=16，另一直角边OH满足OH²+AH²=OA²。"
            ],
            "pitfall": "注意垂径定理中AH是AB的一半，不要误用AB直接代入勾股定理。"
          }
        ]
      },
      {
        "part": "（2）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知PA是切线，OA是半径，所以OA⊥PA，△OAP是直角三角形，目标是求PA。",
              "由切线长定理PA=PB，又OA=OB，OP=OP，所以△OAP≌△OBP，OP垂直平分AB，H在OP上。",
              "在Rt△OAP中，OH是斜边OP上的高，由△OHA~△OAP得OH/OA=AH/AP。"
            ],
            "pitfall": "相似三角形中对应边不能写错：OH对应OA，AH对应AP，不要颠倒。"
          }
        ]
      },
      {
        "part": "（3）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "四边形OAPB由△OAP和△OBP组成，目标是求它的面积。",
              "由切线长定理和半径相等，△OAP≌△OBP，所以四边形面积等于△OAP面积的2倍。",
              "△OAP是直角三角形，直角边OA=20，AP已由第（2）问求出。",
              "四边形面积=2×(1/2×OA×AP)=OA×AP，代入OA=20和AP的数值即可。"
            ],
            "pitfall": "四边形面积是两三角形面积之和，不要漏乘2或误用底和高。"
          }
        ]
      }
