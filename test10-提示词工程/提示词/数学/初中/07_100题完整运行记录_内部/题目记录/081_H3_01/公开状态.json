    "knowledge_points": [
      "垂径定理：OH⊥AB且过圆心，所以H是AB的中点，得到AH=AB/2。",
      "勾股定理：在Rt△OAH中，半径OA、半弦AH、弦心距OH满足OH²+AH²=OA²。",
      "切线性质：PA切圆于A，所以OA⊥PA，△OAP是直角三角形。",
      "相似三角形：△OAH与△OAP有一个公共锐角，且都有一个直角，因此相似，对应边成比例。",
      "四边形面积：四边形OAPB可分成两个全等的直角三角形，面积是△OAP面积的2倍。"
    ],
    "base_formulas": [
      {
        "formula": "OH² + (AB/2)² = OA²",
        "condition": "在圆中，弦心距、半弦和半径构成直角三角形"
      },
      {
        "formula": "PA = PB",
        "condition": "从圆外一点引圆的两条切线，切线长相等"
      },
      {
        "formula": "OA ⊥ PA",
        "condition": "切线垂直于过切点的半径"
      }
    ],
    "parts": [
      {
        "part": "（1）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知圆O的半径OA=5，弦AB=8，要求OH的长。",
              "因为OH⊥AB且O为圆心，由垂径定理得H是AB的中点，所以AH=AB/2=4。",
              "在Rt△OAH中，OA是斜边，AH和OH是直角边，满足OH²+AH²=OA²。"
            ],
            "pitfall": "注意垂径定理中H是AB的中点，所以AH=AB/2=4，不要误把AB直接当作直角边。"
          }
        ]
      },
      {
        "part": "（2）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知半径OA=5，由（1）得OH=3，要求切线长PA。",
              "因为PA切圆于A，所以OA⊥PA，△OAP是直角三角形，OP为斜边。",
              "△OAH与△OAP中，∠AOH=∠AOP（公共角），∠OHA=∠OAP=90°，所以△OAH~△OAP。",
              "由相似得OH/OA=AH/PA，代入OH=3，OA=5，AH=4，得3/5=4/PA。"
            ],
            "pitfall": "相似三角形对应边要写对：OH对应AH，OA对应PA，不要颠倒。"
          }
        ]
      },
      {
        "part": "（3）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "要求四边形OAPB的面积，已知OA=5，PA=20/3。",
              "由切线长定理PA=PB，又OA=OB，所以△OAP≌△OBP，四边形面积是△OAP面积的2倍。",
              "△OAP是直角三角形，直角边为OA和PA，所以S△OAP=1/2×OA×PA。",
              "因此S四边形=2×1/2×OA×PA=OA×PA=5×20/3。"
            ],
            "pitfall": "四边形面积是△OAP面积的2倍，不要漏乘2或误用底乘高。"
          }
        ]
      }
