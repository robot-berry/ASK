    "knowledge_points": [
      "垂径定理：OH垂直平分弦AB，所以AH等于AB的一半。",
      "勾股定理：在直角三角形OAH中，用半径和半弦求OH。",
      "切线性质：PA是切线，所以OA垂直于PA，三角形OAP是直角三角形。",
      "切线长定理：从圆外一点引两条切线，切线长相等，所以PA=PB。",
      "三角形面积公式：四边形OAPB的面积等于两个全等直角三角形面积之和。"
    ],
    "base_formulas": [
      {
        "formula": "OH² + (AB/2)² = OA²",
        "condition": "在圆中，弦心距、半弦和半径构成直角三角形"
      },
      {
        "formula": "PA = PB",
        "condition": "从圆外一点引圆的两条切线，切线长相等"
      },
      {
        "formula": "OA ⊥ PA",
        "condition": "切线垂直于过切点的半径"
      }
    ],
    "parts": [
      {
        "part": "（1）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知圆O的半径OA=50，弦AB=80，要求OH的长。",
              "因为OH⊥AB，且O是圆心，根据垂径定理，H是AB的中点，所以AH=80÷2=40。",
              "在直角三角形OAH中，OA是斜边，OH和AH是直角边，由勾股定理得OH²+AH²=OA²。"
            ],
            "pitfall": "注意AH是AB的一半，不是AB本身；勾股定理中斜边是半径OA。"
          }
        ]
      },
      {
        "part": "（2）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知半径OA=50，AH=40，OH已求出，要求切线长PA。",
              "因为PA切圆于A，所以OA⊥PA，三角形OAP是直角三角形。",
              "由切线长定理，PA=PB，且OP垂直平分AB，所以H是OP与AB的交点，OH是斜边OP上的高。",
              "在直角三角形OAP中，OH⊥AP不成立，但由△OHA~△OAP可得OH/OA=AH/AP。"
            ],
            "pitfall": "相似三角形中对应边不能写错：OH对应AH，OA对应AP。"
          }
        ]
      },
      {
        "part": "（3）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "要求四边形OAPB的面积，它由两个直角三角形OAP和OBP组成。",
              "由PA=PB，OA=OB，OP=OP，可得△OAP≌△OBP，所以两个三角形面积相等。",
              "三角形OAP是直角三角形，直角边为OA和PA，面积等于(1/2)×OA×PA。",
              "四边形OAPB的面积等于2×(1/2)×OA×PA=OA×PA。"
            ],
            "pitfall": "四边形面积是三角形OAP面积的2倍，不要漏乘2。"
          }
        ]
      }
    ],
