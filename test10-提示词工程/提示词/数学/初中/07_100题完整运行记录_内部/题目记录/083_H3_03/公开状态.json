    "parts": [
      {
        "part": "（1）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知圆O的半径OA=15，弦AB=24，要求OH的长。",
              "因为OH⊥AB且O为圆心，由垂径定理得H是AB的中点，所以AH=AB/2=12。",
              "在Rt△OAH中，OA是斜边，AH是直角边，OH是另一条直角边，满足OH²+AH²=OA²。"
            ],
            "pitfall": "注意垂径定理中H是AB的中点，不要误认为AH等于AB。"
          }
        ]
      },
      {
        "part": "（2）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知半径OA=15，由（1）得OH=9，AH=12，要求切线PA的长。",
              "因为PA切圆于A，所以OA⊥PA，△OAP是直角三角形。",
              "△OAH与△OAP都是直角三角形，且共用角∠AOH，所以△OAH~△OAP。",
              "由相似比OH/OA=AH/PA，代入OH=9、OA=15、AH=12，得9/15=12/PA。"
            ],
            "pitfall": "相似三角形对应边要找准，OH对应OA，AH对应PA，不要写反。"
          }
        ]
      },
      {
        "part": "（3）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "要求四边形OAPB的面积，可将其分成△OAP和△OBP。",
              "由切线长定理PA=PB，又OA=OB，OP为公共边，所以△OAP≌△OBP。",
              "因此四边形OAPB的面积等于2倍的△OAP面积。",
              "△OAP是直角三角形，直角边OA=15，PA由（2）可得，所以S△OAP=1/2·OA·PA。"
            ],
            "pitfall": "四边形面积是△OAP面积的2倍，不要漏乘2。"
          }
        ]
      }
