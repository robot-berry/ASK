    "knowledge_points": [
      "垂径定理：OH⊥AB且过圆心，所以H是AB的中点，得到AH=AB/2。",
      "勾股定理：在Rt△OAH中，OA为半径，AH为半弦，OH为弦心距，满足OH²+AH²=OA²。",
      "切线性质：PA切圆于A，所以OA⊥PA，△OAP为直角三角形。",
      "相似三角形：△OAH与△OAP有公共锐角，且均为直角三角形，因此相似，对应边成比例。",
      "四边形面积：四边形OAPB可分割为两个全等直角三角形，面积等于其中一个三角形面积的2倍。"
    ],
    "base_formulas": [
      {
        "formula": "OH² + (AB/2)² = OA²",
        "condition": "在圆中，弦心距、半弦和半径构成直角三角形"
      },
      {
        "formula": "PA = PB",
        "condition": "从圆外一点引圆的两条切线，切线长相等"
      },
      {
        "formula": "OA ⊥ PA",
        "condition": "切线垂直于过切点的半径"
      }
    ],
    "parts": [
      {
        "part": "（1）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知圆O的半径OA=40，弦AB=64，要求OH的长。",
              "因为OH⊥AB且O为圆心，由垂径定理得H是AB的中点，所以AH=AB/2=32。",
              "在Rt△OAH中，OA是斜边，AH和OH是直角边，满足OH²+AH²=OA²。",
              "代入得OH²+32²=40²，即OH²=40²-32²，可先算出差再开方。"
            ],
            "pitfall": "注意OH是弦心距，不是半径；计算时不要误把OH当作40。"
          }
        ]
      },
      {
        "part": "（2）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "已知半径OA=40，由（1）可求出OH，要求切线长PA。",
              "因为PA切圆于A，所以OA⊥PA，△OAP是直角三角形。",
              "△OAH与△OAP都是直角三角形，且共用锐角∠AOH，因此△OAH~△OAP。",
              "由相似得OH/OA=AH/PA，代入OH、OA=40、AH=32，得到关于PA的方程。"
            ],
            "pitfall": "相似三角形对应边不要写错：OH对应OA，AH对应PA。"
          }
        ]
      },
      {
        "part": "（3）",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "要求四边形OAPB的面积，可将其分成△OAP和△OBP。",
              "由切线长定理PA=PB，又OA=OB，OP为公共边，所以△OAP≌△OBP。",
              "因此四边形OAPB的面积等于△OAP面积的2倍。",
              "△OAP是直角三角形，面积=OA×PA/2，代入OA=40和（2）中得到的PA表达式。"
            ],
            "pitfall": "四边形面积是△OAP面积的2倍，不要漏乘2。"
          }
        ]
      }
    ],
