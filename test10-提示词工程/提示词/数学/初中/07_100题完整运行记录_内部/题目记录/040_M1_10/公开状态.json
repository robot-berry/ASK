    "knowledge_points": [
      "二次函数与x轴交点：令y=0，解对应的一元二次方程，得到交点横坐标。",
      "交点式与一般式的转化：将y=-(x-11)(x-15)展开，便于识别系数a、b、c。",
      "对称轴与顶点：对称轴是直线x=-b/(2a)，顶点在对称轴上，纵坐标由函数在该处取值决定。",
      "二次函数最值：开口向下时，顶点纵坐标是函数的最大值。"
    ],
    "base_formulas": [
      {
        "formula": "x=-b/((2a))",
        "condition": "二次函数对称轴公式，其中a、b为一般式y=ax²+bx+c的系数"
      },
      {
        "formula": "y=((4ac-b²))/((4a))",
        "condition": "二次函数顶点纵坐标，在对称轴处取得"
      }
    ],
    "parts": [
      {
        "part": "1",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "函数式y=-(x-11)(x-15)已经分解，令y=0得-(x-11)(x-15)=0。",
              "请结合前面的关系，完成最后一步。",
              "交点纵坐标都是0，所以交点坐标可写成(11,0)和(15,0)。"
            ],
            "pitfall": "令y=0后，不要漏掉负号，两个因式分别等于0即可，不必展开。"
          }
        ]
      },
      {
        "part": "2",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "对称轴需要一般式y=ax²+bx+c中的a和b。",
              "将y=-(x-11)(x-15)展开：先算(x-11)(x-15)=x²-26x+165。",
              "再乘负号得y=-x²+26x-165，所以a=-1，b=26。",
              "代入对称轴公式x=-b/((2a))，得x=-26/[2×(-1)]。"
            ],
            "pitfall": "展开时负号要乘到括号内每一项，不能只乘第一项。"
          }
        ]
      },
      {
        "part": "3",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "函数最大值出现在顶点处，而顶点横坐标就是对称轴。",
              "由第二问的对称轴x=13，顶点横坐标为13。",
              "将x=13代入原函数式，得y=-(13-11)(13-15)。",
              "先算括号内：13-11=2，13-15=-2，所以y=-(2×(-2))。"
            ],
            "pitfall": "顶点纵坐标是最大值，不要与最小值混淆；代入时注意负号。"
          }
        ]
      }
    ],
