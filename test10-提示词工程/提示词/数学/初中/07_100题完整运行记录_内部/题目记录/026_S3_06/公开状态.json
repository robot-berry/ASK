    "knowledge_points": [
      "勾股定理：在直角三角形中，已知两条直角边可以求斜边，本题中AC和BC是直角边。",
      "直角三角形的识别：∠C=90°说明AB是斜边，AC和BC是两条直角边。",
      "三角形周长：周长等于三条边长之和，求出AB后需要把AC、BC、AB相加。"
    ],
    "base_formulas": [
      {
        "formula": "a²+b²=c²",
        "condition": "直角三角形中，两直角边的平方和等于斜边的平方"
      },
      {
        "formula": "C=a+b+c",
        "condition": "三角形的周长等于三条边长之和"
      }
    ],
    "parts": [
      {
        "part": "1",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求斜边AB的长，已知∠C=90°，AC=18，BC=24。",
              "因为∠C是直角，所以AC和BC是两条直角边，AB是斜边，勾股定理的条件满足。",
              "勾股定理的内容是两直角边的平方和等于斜边的平方，对应到本题就是AB²=AC²+BC²。",
              "把AC=18、BC=24代入，得到AB²=18²+24²，先算出平方和，再对结果开算术平方根。"
            ],
            "pitfall": "勾股定理中斜边是平方和开方得到的，不要把AC或BC误当成斜边代入。"
          }
        ]
      },
      {
        "part": "2",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求三角形ABC的周长，周长就是三条边长度的总和。",
              "本题三条边分别是AC、BC、AB，其中AC=18、BC=24已经给出。",
              "AB的长度需要先用勾股定理求出，求出后才能参与周长计算。",
              "周长表达式为AC+BC+AB，把已知的18和24代入，再加上求出的AB。"
            ],
            "pitfall": "周长要把三条边都加起来，求出AB后不要忘记把AB也加入。"
          }
        ]
      }
    ],
