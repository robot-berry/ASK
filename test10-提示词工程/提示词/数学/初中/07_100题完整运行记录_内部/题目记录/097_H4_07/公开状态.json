    "knowledge_points": [
      "对数函数定义域：两个对数式的真数都必须大于零，定义域是这两个真数范围的交集。",
      "对数运算性质：同底对数相加可合并为真数乘积的对数，合并后真数需保持正数。",
      "二次函数最值：合并后的真数是关于x的二次式，配方后可判断在定义域内的变化趋势。",
      "对数不等式：底数大于1时对数函数单调递增，去掉对数符号后不等号方向不变。",
      "定义域限制：解对数不等式所得范围必须与第（1）问的定义域取交集。"
    ],
    "base_formulas": [
      {
        "formula": "logₐ M + logₐ N = logₐ(MN)",
        "condition": "a>0且a≠1，M>0，N>0"
      },
      {
        "formula": "logₐ M ≥ logₐ N ⇔ M ≥ N",
        "condition": "a>1，M>0，N>0"
      },
      {
        "formula": "ab ≤ (((a+b))/2)²，当且仅当a=b时取等号",
        "condition": "a>0，b>0"
      }
