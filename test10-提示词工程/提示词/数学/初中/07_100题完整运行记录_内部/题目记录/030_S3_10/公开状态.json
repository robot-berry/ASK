    "knowledge_points": [
      "勾股定理：在直角三角形中，已知两条直角边可以求斜边。",
      "直角三角形的边角关系：∠C=90°说明AB是斜边，AC和BC是直角边。",
      "三角形周长：周长等于三条边长之和，需要先确定斜边长度。"
    ],
    "base_formulas": [
      {
        "formula": "a²+b²=c²",
        "condition": "直角三角形中，两直角边的平方和等于斜边的平方"
      },
      {
        "formula": "C=a+b+c",
        "condition": "三角形周长等于三边长度之和"
      }
    ],
    "parts": [
      {
        "part": "1",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求斜边AB的长，已知AC=30、BC=40，且∠C=90°。",
              "因为∠C是直角，所以AC和BC是直角边，AB是斜边。",
              "勾股定理给出AB²=AC²+BC²，这是直角三角形中斜边与直角边的基本关系。",
              "代入AC=30、BC=40，得到AB²=30²+40²=900+1600=2500。"
            ],
            "pitfall": "使用勾股定理时，要确认30和40是直角边，不能把其中一条当成斜边。"
          }
        ]
      },
      {
        "part": "2",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求三角形ABC的周长，即AB+AC+BC。",
              "AC=30、BC=40已经给出，斜边AB需要先由勾股定理确定。",
              "由勾股定理得AB²=30²+40²=2500，所以AB=√2500。",
              "周长可表示为√2500+30+40，其中√2500是斜边AB的长度。"
            ],
            "pitfall": "计算周长时不要漏掉斜边AB，也不要把直角边重复计算。"
          }
        ]
      }
    ],
