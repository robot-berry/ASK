    "knowledge_points": [
      "勾股定理：在直角三角形中，已知两条直角边可以求斜边，本题AC、BC是直角边。",
      "直角三角形的识别：∠C=90°说明AB是斜边，AC和BC是两条直角边。",
      "周长概念：三角形周长等于三条边长度之和，求周长前需要先确定AB的长度。"
    ],
    "base_formulas": [
      {
        "formula": "a²+b²=c²",
        "condition": "直角三角形中，两直角边的平方和等于斜边的平方"
      },
      {
        "formula": "C=a+b+c",
        "condition": "三角形周长等于三边长度之和"
      }
    ],
    "parts": [
      {
        "part": "1",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求斜边AB的长，已知AC=6、BC=8，并且∠C=90°。",
              "因为直角在C处，AC和BC是两条直角边，AB是斜边，所以可以使用勾股定理。",
              "代入已知数得到6²+8²=AB²，先算出平方和，再对AB²开平方得到AB的长度。"
            ],
            "pitfall": "不要把AC或BC当成斜边代入，∠C=90°时斜边是AB。"
          }
        ]
      },
      {
        "part": "2",
        "methods": [
          {
            "method_id": "M1",
            "method_name": "模型分层解析",
            "steps": [
              "题目要求三角形ABC的周长，周长就是AB、AC、BC三条边长度的总和。",
              "AC=6、BC=8已经已知，还缺斜边AB的长度，所以要先由勾股定理求出AB。",
              "在直角三角形中，AB²=AC²+BC²，代入6和8可得到AB²的数值。",
              "对AB²开平方得到AB后，把AB、AC、BC代入周长关系AB+AC+BC。"
            ],
            "pitfall": "求周长时三条边都要加，不能漏掉斜边AB，也不能把某条边重复计算。"
          }
        ]
      }
    ],
