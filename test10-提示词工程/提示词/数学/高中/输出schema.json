{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "高中数学搜题五档解析输出",
  "description": "见 00-统一输出结构.md。根字段顺序固定 l1,l2,l3,l4,l5,f,pat,s,u；服务器只做脱敏、校验与渲染。",
  "type": "object",
  "required": ["l1", "l2", "l3", "l4", "l5", "f", "pat", "s", "u"],
  "additionalProperties": false,
  "properties": {
    "l1": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "s"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "string", "description": "题号，原样保留"},
          "s": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "l2": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "l3": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "s"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "string"},
          "s": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "l4": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "s"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "string"},
          "s": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "l5": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "s", "pit"],
        "additionalProperties": false,
        "properties": {
          "n": {"type": "string"},
          "s": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1}
          },
          "pit": {"type": "string", "minLength": 1}
        }
      }
    },
    "f": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["x", "c"],
        "additionalProperties": false,
        "properties": {
          "x": {"type": "string", "minLength": 1, "description": "不带 $ 的 LaTeX 公式，不含本题具体数字"},
          "c": {"type": "string", "minLength": 1, "description": "适用条件"}
        }
      }
    },
    "pat": {"type": "string", "minLength": 1},
    "s": {"type": "string", "enum": ["c", "u"]},
    "u": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
